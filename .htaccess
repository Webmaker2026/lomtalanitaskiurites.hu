# Apache 2.4 / document root. Retain this file when publishing static HTML.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Private development material is not public site content.
RewriteRule ^(?:\.git|\.agents|\.codex|tools|docs|node_modules|artifacts)(?:/|$) - [F,L]
RewriteRule ^(?:package(?:-lock)?\.json|README\.md|\.gitignore)$ - [F,L]

# Old service URLs: direct canonical targets, including old extensionless links.
RewriteRule ^lomtalanitas(?:\.html)?/?$ https://www.lomtalanitaskiurites.hu/lomtalanitas-budapest/ [R=301,L,NE]
RewriteRule ^lakaskiurites(?:\.html)?/?$ https://www.lomtalanitaskiurites.hu/lakaskiurites-budapest/ [R=301,L,NE]
RewriteRule ^munkamenet(?:\.html)?/?$ https://www.lomtalanitaskiurites.hu/blog.html#lakaskiurites-menete [R=301,L,NE]
RewriteRule ^fontos-tudnivalok(?:\.html)?/?$ https://www.lomtalanitaskiurites.hu/blog.html [R=301,L,NE]
RewriteRule ^kep3\.webp$ https://www.lomtalanitaskiurites.hu/assets/kep3.webp [R=301,L,NE]
RewriteRule ^kep4\.webp$ https://www.lomtalanitaskiurites.hu/assets/kiuritott-szoba.webp [R=301,L,NE]
RewriteRule ^lakas-lomtalanitas\.webp$ https://www.lomtalanitaskiurites.hu/assets/lakas-lomtalanitas.webp [R=301,L,NE]
RewriteRule ^(arak|ajanlatkeres|elerhetoseg|galeria|blog|adatvedelem)/?$ https://www.lomtalanitaskiurites.hu/$1.html [R=301,L,NE]
RewriteRule ^(arak|ajanlatkeres|elerhetoseg|galeria|blog|adatvedelem)\.html/+$ https://www.lomtalanitaskiurites.hu/$1.html [R=301,L,NE]

# Only external index.html requests redirect; internal DirectoryIndex does not.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*)index\.html$ https://www.lomtalanitaskiurites.hu/$1 [R=301,L,NE]

# Add slash for actual content directories before canonical-host redirect.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://www.lomtalanitaskiurites.hu/$1/ [R=301,L,NE]

# Canonical host established by existing site. No forwarded-header trust.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.lomtalanitaskiurites\.hu$ [NC]
RewriteRule ^ https://www.lomtalanitaskiurites.hu%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(?:html|xml|txt)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(?:css|js|webp|avif|svg|ico)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

<IfModule mod_filter.c>
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
</IfModule>
</IfModule>

<FilesMatch "^\.">
Require all denied
</FilesMatch>
